---
// src/components/Navbar.astro

interface Category {
  id: string;
  name: string;
  image_url: string;
}

interface Props {
  // Ponemos el signo "?" para indicar que puede ser opcional y no se caiga el sistema
  store?: {
    name: string;
    description: string;
    logo_url: string;
    secondary_color: string;
  };
  categories: Category[];
}

// Desestructuramos las props
const { store, categories } = Astro.props;

// Creamos un objeto seguro: si "store" no existe, usa tus datos de Artesanías Killa por defecto
const tiendaSegura = {
  name: store?.name || "Artesanías Killa",
  description: store?.description || "Descubre la magia de los andes. Ropa de alpaca, carteras de cuero y accesorios hechos a mano por artesanos peruanos.",
  logo_url: store?.logo_url || "/images/tienda.png",
  secondary_color: store?.secondary_color || "#8f8f71"
};
---

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
/>

<nav class="nav">
  <img src={tiendaSegura.logo_url} alt="foto" class="img-circular" />
  
  <h1 class="titulo">{tiendaSegura.name}</h1>

  <h3 class="subtitulo">
    {tiendaSegura.description}
    <br />
    <span class="firma-autor">Desarrollado por jose luis_xd, sin criticar por fis :).</span>
  </h3>

  <div class="botones-accion-group">
    <button class="btn-catalogo" onclick="window.location.href='/catalogo'">
      Ver catálogo
    </button>
    <button class="btn-whatsapp" onclick="window.location.href='/contacto'">
      Consultar
    </button>
  </div>

  <div class="redes">
    <a href="https://instagram.com" target="_blank"><i class="fa-brands fa-instagram"></i></a>
    <a href="https://tiktok.com" target="_blank"><i class="fa-brands fa-tiktok"></i></a>
  </div>

  <h3 class="pregunta">¿Qué estás buscando?</h3>
  <h4 class="explora">Explora nuestros catálogos principales</h4>

  <div class="contenedor">
    {categories && categories.length > 0 ? (
      categories.map((cat) => (
        <div class="card">
          <img src={cat.image_url || "/images/placeholder.png"} alt={cat.name} />
          <h3>{cat.name}</h3>
          <a href={`/catalogo?categoria=${cat.id}`} class="btn-ir-cat">
            <span class="flecha"></span>
          </a>
        </div>
      ))
    ) : (
      <div class="card">
        <img src="/images/ropa_alpaca.png" alt="producto 1" />
        <h3>ropa de alpaca</h3>
      </div>
      <div class="card">
        <img src="/images/cartera_cuero.png" alt="producto 2" />
        <h3>carteras y cuero</h3>
      </div>
      <div class="card">
        <img src="/images/accesorios.png" alt="producto 3" />
        <h3>accesorios</h3>
      </div>
    )}
  </div>
</nav>

<style define:vars={{ fondoNav: tiendaSegura.secondary_color }}>
  .nav {
    background: var(--fondoNav) !important;
    padding: 2rem 1rem;
    text-align: center;
    margin: 0.5rem;
    border-radius: 16px;
    font-family: system-ui, -apple-system, sans-serif;
  }
  /* ... El resto de tus estilos de la card, botones, etc., se quedan exactamente IGUAL ... */
  .titulo {
    font-size: 40px;
    font-weight: bold;
    color: white; 
    text-align: center; 
    margin: 15px 0 5px 0; 
}
  .subtitulo { 
    font-size: 18px; 
    font-weight: 500; 
    color: rgba(255, 255, 255, 0.9); 
    text-align: center; 
    max-width: 700px; 
    margin: 0 auto 25px auto; 
    line-height: 1.5; 
}
  .firma-autor { 
    font-size: 13px; 
    font-style: italic; 
    opacity: 0.7; display: inline-block; margin-top: 10px; }
  .botones-accion-group { display: flex; justify-content: center; gap: 15px; margin-bottom: 25px; flex-wrap: wrap; }
  .pregunta { color: #111827; font-size: 28px; font-weight: 700; margin-top: 40px; margin-bottom: 5px; }
  .explora { color: #474741; font-size: 15px; margin-bottom: 20px; }
  .contenedor { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin-top: 15px; }
  .card { width: 190px; text-align: center; background: white; padding: 12px; border-radius: 16px; box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1); transition: transform 0.3s ease, box-shadow 0.3s ease; display: flex; flex-direction: column; align-items: center; justify-content: space-between; }
  .card:hover { transform: translateY(-5px) scale(1.05) !important; box-shadow: 0 12px 22px rgba(0, 0, 0, 0.2); }
  .card img { width: 100%; height: 130px; border-radius: 12px; object-fit: cover; }
  .card h3 { margin: 10px 0; font-size: 15px; font-weight: 600; color: #374151; text-transform: capitalize; }
  .btn-ir-cat { background: #232324; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-decoration: none; margin-top: 5px; transition: background 0.2s; }
  .btn-ir-cat:hover { background: #41aa26; }
  .flecha { border: solid white; border-width: 0 2.5px 2.5px 0; display: inline-block; padding: 3px; transform: rotate(-45deg); margin-left: -2px; }
  .btn-catalogo { padding: 14px 26px; background: #232324; color: #fff; border: none; border-radius: 14px; font-size: 16px; font-weight: 600; cursor: pointer; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15); transition: all 0.3s ease; }
  .btn-catalogo:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 12px 25px rgba(0, 0, 0, 0.2); }
  .btn-whatsapp { padding: 14px 26px; background: #41aa26; color: #fff; border: none; border-radius: 14px; font-size: 16px; font-weight: 600; cursor: pointer; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15); transition: all 0.3s ease; }
  .btn-whatsapp:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 12px 25px rgba(0, 0, 0, 0.2); }
  .img-circular { width: 140px; height: 140px; border-radius: 50%; object-fit: cover; margin: 0 auto; border: 4px solid white; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
  .redes { display: flex; justify-content: center; gap: 20px; margin: 10px 0 25px 0; }
  .redes a { font-size: 26px; color: rgba(255, 255, 255, 0.8); transition: transform 0.2s, color 0.2s; }
  .redes a:hover { transform: scale(1.2); color: #ffffff; }
</style>



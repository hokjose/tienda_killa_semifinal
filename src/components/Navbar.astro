---
// 👇 1. Recibimos 'contacts' además de las props que ya tenías
const { store, categories = [], contacts = [] } = Astro.props;

// 👇 2. Buscamos el contacto que esté marcado como principal (is_primary === true)
// Si no hay ninguno marcado como favorito, buscamos el primero que sea de tipo 'whatsapp'
const contactoPrincipal =
  contacts.find((c) => c.is_primary === true) ||
  contacts.find((c) => c.type === "whatsapp");

// 👇 3. Definimos una URL de respaldo por si la base de datos está totalmente vacía en pruebas
const urlRespaldo = "https://wa.me/51999999999";

// 👇 4. Si existe el contacto en la BD usamos su 'url', si no, usamos el respaldo
const urlFinal = contactoPrincipal ? contactoPrincipal.url : urlRespaldo;
const textoBoton = contactoPrincipal ? contactoPrincipal.name : "Consultar";
---

<section class="home-container">
  <img src={store?.logo_url} alt={store?.name} class="img-circular" />

  <h1 class="titulo">
    {store?.name}
  </h1>

  <h3 class="subtitulo">
    {store?.description}
  </h3>

  <div class="botones">
    <a href="/catalogo" class="btn-catalogo"> Ver catálogo </a>

    <a
      href={urlFinal}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-contacto"
    >
      {textoBoton}
    </a>
  </div>

  <h2 class="pregunta">¿Qué estás buscando?</h2>

  <p class="explora">Explora nuestros catálogos principales</p>

  <div class="contenedor-categorias">
    {
      categories.map((cat) => (
        /* Pequeña corrección estructural para que tus estilos .card-bg, .card-gradiente y .card-info funcionen idéntico a tu CSS */
        <div class="card">
          <img src={cat.image_url} alt={cat.name} class="card-bg" />

          <div class="card-gradiente" />

          <div class="card-info">
            <div class="textos">
              <h3>{cat.name}</h3>
              {/* Muestra dinámicamente la cantidad de productos si lo deseas */}
              <p>{cat.active_products_count || 0} Productos</p>
            </div>

            <a
              href={`/catalogo?categoria=${cat.id}`}
              class="btn-ir flecha-circular"
            >
              →
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* =========================================
     1. CONTENEDOR PRINCIPAL Y TEXTOS
     ========================================= */
  .home-container {
    width: 100%;
    min-height: 100vh;
    padding: 4rem 1rem;

    /* Centrado Mágico Flexbox */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;

    /* 👇 RUTA CORREGIDA CON TU IMAGEN PNG EXACTA 👇 */
    background-image:
      linear-gradient(
        to bottom,
        rgba(80, 137, 141, 0.85) 0%,
        rgba(0, 0, 0, 0.4) 100%
      ),
      url("/imagen/fondo-nav.png") !important;
    background-size: cover !important; /* Cubre toda la pantalla */
    background-position: center !important; /* Centra la imagen */
    background-repeat: no-repeat !important; /* No se repite */
    background-attachment: fixed !important; /* Efecto estático pro al scrollear */
  }

  .img-circular {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 20px;
    border: 4px solid white;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .titulo {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 800;
    color: white;
    margin-bottom: 10px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3); /* Sombra al texto para que resalte más sobre el fondo */
  }

  .subtitulo {
    max-width: 800px;
    margin: auto;
    color: white;
    line-height: 1.8;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3); /* Sombra al texto */
  }

  /* =========================================
     2. BOTONES DE ACCIÓN PRINCIPALES
     ========================================= */
  .botones {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .btn-catalogo,
  .btn-contacto {
    padding: 14px 26px;
    border-radius: 14px;
    font-weight: 700;
    transition: 0.3s;
    text-decoration: none;
  }

  .btn-catalogo {
    background: var(--primary-color);
    color: white;
  }

  .btn-contacto {
    background: var(--accent-color);
    color: white;
  }

  .btn-catalogo:hover,
  .btn-contacto:hover {
    transform: translateY(-3px);
  }

  /* =========================================
     3. SECCIÓN DE PREGUNTA
     ========================================= */
  .pregunta {
    margin-top: 60px;
    font-size: 2rem;
    color: var(--text-color);
  }

  .explora {
    color: #64748b;
    margin-top: 10px;
    margin-bottom: 30px;
  }

  /* =========================================
     4. TARJETAS DE CATEGORÍAS (TIPO PORTADA)
     ========================================= */
  .contenedor-categorias {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .card {
    position: relative;
    width: 300px;
    height: 200px;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
    display: block;
    background-color: #cbd5e1;
  }

  .card:hover {
    transform: translateY(-6px);
  }

  .card-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .card-gradiente {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 60%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
    z-index: 2;
  }

  .card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 20px;
    box-sizing: border-box;
    z-index: 3;

    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .textos {
    text-align: left;
  }

  .textos h3 {
    color: white;
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0 0 5px 0;
  }

  .textos p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    margin: 0;
  }

  .flecha-circular {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(5px);
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 14px;
    transition: background 0.3s ease;
  }

  .card:hover .flecha-circular {
    background: var(--primary-color);
  }

  /* =========================================
     5. RESPONSIVE (MÓVILES)
     ========================================= */
  @media (max-width: 768px) {
    .contenedor-categorias {
      gap: 15px;
    }
    .card {
      width: 100%;
      max-width: 320px;
    }
  }
</style>

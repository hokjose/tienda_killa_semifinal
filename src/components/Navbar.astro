---
const { store, categories = [] } = Astro.props;
---

<section class="home-container">
  <img src={store?.logo_url} alt={store?.name} class="img-circular" />

  <h1 class="titulo">
    {store?.name}
  </h1>

  <h3 class="subtitulo">
    {store?.description}
  </h3>

  <div class="botones">
    <a href="/catalogo" class="btn-catalogo"> Ver catálogo </a>

    <a href="/contacto" class="btn-contacto"> Consultar </a>
  </div>

  <h2 class="pregunta">¿Qué estás buscando?</h2>

  <p class="explora">Explora nuestros catálogos principales</p>

  <div class="contenedor-categorias">
    {
      categories.map((cat) => (
        <div class="card">
          <img src={cat.image_url} alt={cat.name} />

          <h3>{cat.name}</h3>

          <a href={`/catalogo?categoria=${cat.id}`} class="btn-ir">
            →
          </a>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* =========================================
     1. CONTENEDOR PRINCIPAL Y TEXTOS
     ========================================= */
  .home-container {
    width: 100%;
    min-height: 100vh;
    padding: 4rem 1rem;

    /* Centrado Mágico Flexbox */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;
    /* 👇 AQUÍ ESTÁ EL CAMBIO: Degradado fijo de celeste (#89f7fe) a blanco (#ffffff) 👇 */
    background: linear-gradient(to bottom, #50898d 0%, white 100%) !important;
  }

  .img-circular {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 20px;
    border: 4px solid white;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .titulo {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 800;
    color: white;
    margin-bottom: 10px;
  }

  .subtitulo {
    max-width: 800px;
    margin: auto;
    color: white;
    line-height: 1.8;
  }

  /* =========================================
     2. BOTONES DE ACCIÓN PRINCIPALES
     ========================================= */
  .botones {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 30px;
    flex-wrap: wrap;
  }

  .btn-catalogo,
  .btn-contacto {
    padding: 14px 26px;
    border-radius: 14px;
    font-weight: 700;
    transition: 0.3s;
    text-decoration: none;
  }

  .btn-catalogo {
    background: var(--primary-color);
    color: white;
  }

  .btn-contacto {
    background: var(--accent-color);
    color: white;
  }

  .btn-catalogo:hover,
  .btn-contacto:hover {
    transform: translateY(-3px);
  }

  /* =========================================
     3. SECCIÓN DE PREGUNTA
     ========================================= */
  .pregunta {
    margin-top: 60px;
    font-size: 2rem;
    color: var(--text-color);
  }

  .explora {
    color: #64748b;
    margin-top: 10px;
    margin-bottom: 30px;
  }

  /* =========================================
     4. TARJETAS DE CATEGORÍAS (TIPO PORTADA)
     ========================================= */
  .contenedor-categorias {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .card {
    position: relative;
    width: 300px;
    height: 200px;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease;
    display: block;
    background-color: #cbd5e1;
  }

  .card:hover {
    transform: translateY(-6px);
  }

  .card-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .card-gradiente {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 60%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
    z-index: 2;
  }

  .card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 20px;
    box-sizing: border-box;
    z-index: 3;

    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .textos {
    text-align: left;
  }

  .textos h3 {
    color: white;
    font-size: 1.4rem;
    font-weight: 800;
    margin: 0 0 5px 0;
  }

  .textos p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    margin: 0;
  }

  .flecha-circular {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(5px);
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 14px;
    transition: background 0.3s ease;
  }

  .card:hover .flecha-circular {
    background: var(--primary-color);
  }

  /* =========================================
     5. RESPONSIVE (MÓVILES)
     ========================================= */
  @media (max-width: 768px) {
    .contenedor-categorias {
      gap: 15px;
    }
    .card {
      width: 100%;
      max-width: 320px;
    }
  }
</style>

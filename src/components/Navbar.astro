---
const { store, categories = [] } = Astro.props;
---

<section class="home-container">
  <img src={store?.logo_url} alt={store?.name} class="img-circular" />

  <h1 class="titulo">
    {store?.name}
  </h1>

  <h3 class="subtitulo">
    {store?.description}
  </h3>

  <div class="botones">
    <a href="/catalogo" class="btn-catalogo"> Ver catálogo </a>

    <a href="/contacto" class="btn-contacto"> Consultar </a>
  </div>

  <h2 class="pregunta">¿Qué estás buscando?</h2>

  <p class="explora">Explora nuestros catálogos principales</p>

  <div class="contenedor-categorias">
    {
      categories.map((cat) => (
        <div class="card">
          <img src={cat.image_url} alt={cat.name} />

          <h3>{cat.name}</h3>

          <a href={`/catalogo?categoria=${cat.id}`} class="btn-ir">
            →
          </a>
        </div>
      ))
    }
  </div>
</section>

<style>
  .home-container {
    width: 100%;

    min-height: 100vh;

    padding: 2rem 1rem 4rem;

    text-align: center;

    background: linear-gradient(to bottom, #407275 0%, #ffffff 100%);
  }
  .img-circular {
    width: 160px;
    height: 160px;

    border-radius: 50%;

    object-fit: cover;

    margin: 0 auto 20px;

    border: 4px solid white;

    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  }

  .titulo {
    font-size: clamp(2rem, 6vw, 4rem);

    font-weight: 800;

    color: white;

    margin-bottom: 10px;
  }

  .subtitulo {
    max-width: 800px;

    margin: auto;

    color: white;

    line-height: 1.8;
  }

  .botones {
    display: flex;

    justify-content: center;

    gap: 15px;

    margin-top: 30px;

    flex-wrap: wrap;
  }

  .btn-catalogo,
  .btn-contacto {
    padding: 14px 26px;

    border-radius: 14px;

    font-weight: 700;

    transition: 0.3s;
  }

  .btn-catalogo {
    background: #0f172a;

    color: white;
  }

  .btn-contacto {
    background: #22c55e;

    color: white;
  }

  .btn-catalogo:hover,
  .btn-contacto:hover {
    transform: translateY(-3px);
  }

  .pregunta {
    margin-top: 60px;

    font-size: 2rem;

    color: #0f172a;
  }

  .explora {
    color: #64748b;

    margin-top: 10px;

    margin-bottom: 30px;
  }

  .contenedor-categorias {
    display: flex;

    flex-wrap: wrap;

    justify-content: center;

    gap: 25px;

    max-width: 1200px;

    margin: 0 auto;
  }

  .card {
    width: 260px;

    background: white;

    border-radius: 20px;

    overflow: hidden;

    padding: 15px;

    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);

    transition: 0.3s;

    display: flex;

    flex-direction: column;
  }

  .card:hover {
    transform: translateY(-8px);
  }

  .card img {
    width: 100%;

    height: 180px;

    object-fit: cover;

    border-radius: 12px;
  }

  .card h3 {
    margin: 15px 0;

    color: #0f172a;

    text-align: center;
  }

  .btn-ir {
    width: 40px;
    height: 40px;

    display: flex;

    justify-content: center;
    align-items: center;

    margin: auto;

    border-radius: 50%;

    background: #2563eb;

    color: white;

    font-weight: bold;
  }

  @media (max-width: 768px) {
    .contenedor-categorias {
      gap: 15px;
    }

    .card {
      width: 100%;
      max-width: 320px;
    }
  }
</style>

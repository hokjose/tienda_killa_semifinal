---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import { supabase } from "../lib/supabase";

const STORE_ID = import.meta.env.PUBLIC_STORE_ID;

const { data: store } = await supabase
  .from("vw_store_public")
  .select("*")
  .eq("id", STORE_ID)
  .single();

const { data: contacts } = await supabase
  .from("vw_store_public_contacts")
  .select("*")
  .eq("store_id", STORE_ID);

const { data: categories } = await supabase
  .from("vw_store_public_categories")
  .select("*")
  .eq("store_id", STORE_ID);
---

<!-- Prueba -->
<MainLayout store={store} contacts={contacts}>
  <Navbar store={store} categories={categories || []} />
</MainLayout>
